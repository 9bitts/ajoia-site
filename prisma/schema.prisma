generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COLUMNIST
  LIVREIRO
}

enum ArticleStatus {
  DRAFT
  PENDING
  PUBLISHED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  slug         String    @unique
  role         Role      @default(COLUMNIST)
  bio          String    @default("")
  avatarUrl    String?
  roleLabel    String    @default("Colunista")
  featured     Boolean   @default(false)
  active              Boolean  @default(true)
  approved            Boolean  @default(true)
  credentialVersion   Int      @default(0)
  mustChangePassword  Boolean  @default(false)
  totpSecret          String?
  totpEnabled         Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  articles            Article[]
}

model Article {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  dek         String        @default("")
  body        String
  section     String
  status      ArticleStatus @default(DRAFT)
  featured    Boolean       @default(false)
  principal   Boolean       @default(false)
  breaking    Boolean       @default(false)
  imageUrl       String?
  imageAlt       String        @default("")
  seoTitle       String        @default("")
  seoDescription String        @default("")
  noindex        Boolean       @default(false)
  isOpinion      Boolean?
  secondarySections String[] @default([])
  authorId       String
  author         User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  revision ArticleRevision?
  socialPosts SocialPublication[]
  gallery ArticleGalleryImage[]

  @@index([status, publishedAt])
  @@index([status, noindex, publishedAt])
  @@index([section])
  @@index([authorId])
}

model ArticleRevision {
  id             String   @id @default(cuid())
  articleId      String   @unique
  article        Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  title          String
  dek            String   @default("")
  body           String
  section        String
  slug           String
  imageUrl       String?
  imageAlt       String   @default("")
  seoTitle       String   @default("")
  seoDescription String   @default("")
  isOpinion      Boolean?
  secondarySections String[] @default([])
  galleryJson       String   @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ArticleGalleryImage {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  url       String
  caption   String  @default("")
  position  Int

  @@index([articleId, position])
}

model MediaAsset {
  id        String   @id @default(cuid())
  url       String   @unique
  alt       String   @default("")
  bytes     Int      @default(0)
  userId    String?
  createdAt DateTime @default(now())
}

model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id           String    @id @default(cuid())
  email        String    @unique
  confirmed    Boolean   @default(true)
  confirmToken String?   @unique
  unsubToken   String?   @unique
  confirmedAt  DateTime?
  createdAt    DateTime  @default(now())
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

model UploadEvent {
  id        String   @id @default(cuid())
  userId    String
  bytes     Int
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum SocialNetwork {
  FACEBOOK
  INSTAGRAM
  X
}

model SocialConnection {
  network      SocialNetwork @id
  accountId    String
  accountName  String
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  updatedAt    DateTime      @updatedAt
}

model SocialPublication {
  id          String        @id @default(cuid())
  articleId   String
  article     Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  network     SocialNetwork
  text        String
  externalId  String?
  externalUrl String?
  ok          Boolean
  error       String?
  createdAt   DateTime      @default(now())

  @@index([articleId, network, createdAt])
}

model SocialHandoff {
  id        String   @id
  payload   String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  targetType String?
  targetId   String?
  detail     String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

enum StoreItemKind {
  LIVRO
  OUTRO
}

enum StoreItemStatus {
  DRAFT
  PUBLISHED
}

enum BookBinding {
  BROCHURA
  DURA
  POCKET
}

enum StoreOrderStatus {
  AGUARDANDO_PAGAMENTO
  PAGO
  ENVIADO
  ENTREGUE
  CANCELADO
}

model StoreCategory {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String      @default("")
  position    Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       StoreItem[]
}

model StoreItem {
  id          String          @id @default(cuid())
  kind        StoreItemKind
  slug        String          @unique
  name        String
  synopsis    String          @default("")
  description String          @default("")
  priceCents  Int
  stock       Int             @default(0)
  coverUrl    String?
  coverAlt    String          @default("")
  status      StoreItemStatus @default(DRAFT)
  featured    Boolean         @default(false)
  weightGrams Int             @default(0)
  widthCm     Int             @default(0)
  heightCm    Int             @default(0)
  depthCm     Int             @default(0)
  isbn13      String?         @unique
  authors     String          @default("")
  publisher   String          @default("")
  edition     String          @default("")
  year        Int?
  pages       Int?
  language    String          @default("")
  binding     BookBinding?
  categoryId  String?
  category    StoreCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  orderLines  StoreOrderLine[]

  @@index([status, featured])
  @@index([status, createdAt])
  @@index([categoryId])
  @@index([kind])
}

model StoreOrder {
  id            String           @id @default(cuid())
  code          String           @unique
  status        StoreOrderStatus @default(AGUARDANDO_PAGAMENTO)
  buyerName     String
  buyerEmail    String
  buyerPhone    String           @default("")
  addressLine   String           @default("")
  addressCity   String           @default("")
  addressState  String           @default("")
  addressZip    String           @default("")
  subtotalCents Int
  freightCents  Int              @default(0)
  totalCents    Int
  paymentRef    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  lines         StoreOrderLine[]

  @@index([status, createdAt])
}

model StoreOrderLine {
  id        String      @id @default(cuid())
  orderId   String
  order     StoreOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId    String?
  item      StoreItem?  @relation(fields: [itemId], references: [id], onDelete: SetNull)
  name      String
  unitCents Int
  quantity  Int

  @@index([orderId])
}
