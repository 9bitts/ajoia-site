# Database — Railway Postgres (produção) ou docker compose (local)
# Local: docker compose up -d
# DATABASE_URL="postgresql://ajoia:ajoia@localhost:5432/ajoia?schema=public"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Primeiro administrador. Usado só se a conta ainda não existe.
# O seed não reescreve senha de quem já está no banco.
ADMIN_EMAIL="admin@ajoiabrasil.com.br"
ADMIN_PASSWORD=""

# Alerta de erro (opcional). Recebe JSON { context, message, at }. Sem senha e sem corpo de e-mail.
# ERROR_WEBHOOK_URL=""

# Turnstile (Cloudflare). Com a chave secreta, contato, newsletter e cadastro exigem o token.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# Limpeza de contato (12 meses) e newsletter não confirmada (14 dias).
# Agende um GET/POST com Authorization: Bearer <CRON_SECRET> em /api/cron/retain
# CRON_SECRET=""

# Uploads — no Railway monte volume em /data e use:
# UPLOAD_DIR=/data/uploads
UPLOAD_DIR="public/uploads"

# URL pública do portal. Em produção: https://ajoiabrasil.com.br
NEXT_PUBLIC_SITE_URL="https://ajoiabrasil.com.br"

# Medição. Preencha um dos dois depois de criar a conta.
# GTM tem prioridade. O container precisa de uma tag GA4.
# NEXT_PUBLIC_GTM_ID="GTM-XXXX"
# Sem GTM, o site carrega o GA4 direto:
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXX"

# IndexNow (Bing). O site já publica uma chave em /indexnow-key.txt e avisa
# o Bing a cada matéria publicada. Preencha só para trocar essa chave.
# INDEXNOW_KEY=""

# Caixa do portal. Senha de app do Google (não é a senha da conta):
# Conta Google → Segurança → Verificação em duas etapas → Senhas de app.
GMAIL_USER="portal.ajoiabrasil@gmail.com"
GMAIL_APP_PASSWORD=""

# Redes. O painel em /admin/redes explica o aplicativo da Meta e o do X.
# Não commite estes valores.
# META_APP_ID=""
# META_APP_SECRET=""
# Só se o app usar Login do Facebook para Empresas com ID de configuração:
# META_CONFIG_ID=""
# META_GRAPH_VERSION="v25.0"
# X_CLIENT_ID=""
# X_CLIENT_SECRET=""

# IA opcional, no formato da API da OpenAI (OpenAI, xAI, Groq).
# Sem chave, o painel usa um recorte editorial e o botão de IA avisa.
# SOCIAL_AI_API_KEY=""
# SOCIAL_AI_BASE_URL="https://api.openai.com/v1"
# SOCIAL_AI_MODEL="gpt-4o-mini"
