# Database — Railway Postgres (produção) ou docker compose (local)
# Local: docker compose up -d
# DATABASE_URL="postgresql://ajoia:ajoia@localhost:5432/ajoia?schema=public"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Seed (primeiro deploy)
ADMIN_EMAIL="admin@ajoiabrasil.com.br"
ADMIN_PASSWORD=""
COLUMNIST_PASSWORD=""

# Uploads — no Railway monte volume em /data e use:
# UPLOAD_DIR=/data/uploads
UPLOAD_DIR="public/uploads"

# URL pública do portal. Em produção: https://ajoiabrasil.com.br
NEXT_PUBLIC_SITE_URL="https://ajoiabrasil.com.br"

# Medição. Preencha um dos dois depois de criar a conta.
# GTM tem prioridade. O container precisa de uma tag GA4.
# NEXT_PUBLIC_GTM_ID="GTM-XXXX"
# Sem GTM, o site carrega o GA4 direto:
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXX"

# IndexNow (Bing). Gere com: openssl rand -hex 16
# O site publica a chave em /indexnow-key.txt e avisa ao publicar.
# INDEXNOW_KEY=""

# Caixa do portal. Senha de app do Google (não é a senha da conta):
# Conta Google → Segurança → Verificação em duas etapas → Senhas de app.
GMAIL_USER="portal.ajoiabrasil@gmail.com"
GMAIL_APP_PASSWORD=""
